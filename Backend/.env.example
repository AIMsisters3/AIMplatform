# Copy this file to .env and fill in real values.
# .env is git-ignored — it should never be committed.
# On a fresh local checkout with XAMPP, config/env.php auto-generates a
# working .env for you (random JWT secret, local DB defaults, no SMTP),
# so this file is mainly a reference and a template for production.

APP_ENV=local
APP_URL=http://localhost/AIMTech/Backend
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins allowed to call the API in production,
# e.g. ALLOWED_ORIGINS_EXTRA=https://aimsisters.org,https://www.aimsisters.org
ALLOWED_ORIGINS_EXTRA=

# --- Database ---
DB_HOST=localhost
DB_NAME=aimsisters_db
DB_USER=root
DB_PASS=

# --- JWT ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# --- Uploads ---
# Ceiling on the ASSEMBLED file size in MB (default 20000 = ~20GB) for
# large media uploaded via the chunked endpoints (video/audio/PDF from the
# Upload Content page). This is a disk-usage safety cap, not a technical
# limit — because uploads are chunked, it is NOT tied to PHP's
# upload_max_filesize/post_max_size (see Backend/.user.ini, which only
# needs to fit one chunk). Raise it freely for even larger files.
MAX_UPLOAD_SIZE_MB=20000
# Size of each chunk in MB. Backend/.user.ini's upload_max_filesize/
# post_max_size must comfortably exceed this (they default to 20M/24M,
# which fits the default 8MB chunk size with room for multipart overhead).
CHUNK_SIZE_MB=8

# --- SMTP (leave blank to disable outgoing email locally) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM_EMAIL=no-reply@aimsisters.org
SMTP_FROM_NAME=AIMsisters

# --- Branded email logo ---
# Shown in the welcome/devotion/Bible-study/news notification emails
# (Backend/emails/). Leave unset to default to APP_URL + /assets/logo.png
# (this backend serving Backend/assets/logo.png itself) — fine once
# APP_URL is a real public HTTPS URL, but email clients cannot load a
# localhost image, so during local development the logo simply won't
# render in a real inbox. Set this explicitly to any publicly reachable
# HTTPS image (e.g. a CDN copy of the logo) to override.
MAIL_LOGO_URL=
