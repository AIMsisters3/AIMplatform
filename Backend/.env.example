# Copy this file to .env and fill in real values.
# .env is git-ignored — it should never be committed.
# On a fresh local checkout with XAMPP, config/env.php auto-generates a
# working .env for you (random JWT secret, local DB defaults, no SMTP),
# so this file is mainly a reference and a template for production.

APP_ENV=local
APP_URL=http://localhost/AIMTech/Backend
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins allowed to call the API in production,
# e.g. ALLOWED_ORIGINS_EXTRA=https://aimsisters.org,https://www.aimsisters.org
ALLOWED_ORIGINS_EXTRA=

# --- Database ---
DB_HOST=localhost
DB_NAME=aimsisters_db
DB_USER=root
DB_PASS=

# --- JWT ---
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# --- SMTP (leave blank to disable outgoing email locally) ---
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_FROM_EMAIL=no-reply@aimsisters.org
SMTP_FROM_NAME=AIMsisters
