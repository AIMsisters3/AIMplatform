# Defense in depth: this directory only ever holds media/document files
# saved by UploadController (which enforces an extension + MIME-type
# whitelist and always renames to a server-generated filename), so this
# is a backup layer, not the primary defense. Kept deliberately minimal
# (no Options, no caching headers) - some very restrictive shared hosts
# reject a .htaccess file entirely (500 error on every file in this
# folder) if it uses a directive type outside a narrow allowed set, and
# this bare FilesMatch block is the one thing worth risking that on.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php\d|phar|cgi|pl)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php\d|phar|cgi|pl)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
