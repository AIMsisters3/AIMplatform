# Copy this file to .env.production and fill in the real value before
# running `npm run build` for a deployment (e.g. InfinityFree staging).
# Not needed for local dev (`npm run dev`) — leave VITE_BACKEND_URL unset
# and requests stay relative, handled by vite.config.js's dev-server proxy.
#
# Vite only exposes env vars prefixed VITE_ to client-side code, and only
# reads *.env* files at build time — this is never a runtime secret, just
# the public URL of your own deployed backend, so it's safe to see in the
# built JS bundle.

# The deployed Backend folder's own base URL (no trailing slash, no
# /api suffix — that's added automatically). Example for InfinityFree,
# with Backend/ uploaded to htdocs/backend/:
VITE_BACKEND_URL=https://aimsisters.ct.ws/backend

# --- Sign in with Google ---
# The OAuth Client ID from Google Cloud Console -> APIs & Services ->
# Credentials -> your Web application client (ends in
# .apps.googleusercontent.com) - the same value Backend/.env's own
# GOOGLE_CLIENT_ID uses. Not secret, safe in the built JS bundle.
#
# Unlike VITE_BACKEND_URL above, this one IS needed for local dev too
# (npm run dev reads plain Frontend/.env, not just .env.production) -
# copy this file to Frontend/.env (not just .env.production) and fill
# this line in to test Google sign-in on localhost.
VITE_GOOGLE_CLIENT_ID=
