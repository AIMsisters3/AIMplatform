# Vite copies everything in public/ verbatim into dist/ on build, so this
# ships to the production web root alongside index.html and assets/.
#
# React Router (BrowserRouter, see src/main.jsx) needs real URLs like
# /admin/login or /content?item=... to work on a hard refresh or a direct
# link — without this, Apache 404s on any path that isn't a real file,
# because there's no file at e.g. /admin/login on disk. This rewrites any
# request that doesn't match a real file or directory back to index.html,
# letting React Router take over client-side routing from there.
RewriteEngine On

# Route backend API requests straight to the backend's own index.php from
# here, instead of relying on a second, nested .htaccess inside the
# backend folder to rewrite api/* itself — some shared hosts silently
# ignore rewrite rules in a nested .htaccess even though the root one
# works fine, which otherwise lets this request fall through to the SPA
# fallback below and get served index.html instead of ever reaching PHP.
# CHANGE "server" HERE if your backend folder is named differently.
RewriteRule ^server/api/(.*)$ server/index.php [QSA,L]

# A real file or directory (backend PHP files, uploads/, assets/, etc.)
# is served as-is — don't apply the SPA fallback below to it.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# React Router (BrowserRouter, see src/main.jsx) needs real URLs like
# /admin/login or /content?item=... to work on a hard refresh or a direct
# link — without this, Apache 404s on any path that isn't a real file.
# Anything left at this point isn't a real file/directory and isn't a
# backend API call, so hand it to index.html and let React Router take
# over client-side routing from there.
RewriteRule ^ index.html [L]
