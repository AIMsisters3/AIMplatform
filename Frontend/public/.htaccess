# Vite copies everything in public/ verbatim into dist/ on build, so this
# ships to the production web root alongside index.html and assets/.
#
# React Router (BrowserRouter, see src/main.jsx) needs real URLs like
# /admin/login or /content?item=... to work on a hard refresh or a direct
# link — without this, Apache 404s on any path that isn't a real file,
# because there's no file at e.g. /admin/login on disk. This rewrites any
# request that doesn't match a real file or directory back to index.html,
# letting React Router take over client-side routing from there.
RewriteEngine On

# NOTE: some shared/free hosts restrict AllowOverride so that .htaccess
# rewrite directives (this whole file) are silently ignored — no error,
# they just never fire. On such a host, a direct link like /admin/login
# will 404 on a hard refresh instead of falling back to index.html below;
# there's no fix for that from inside .htaccess itself. Backend API calls
# don't depend on this file at all — see Frontend/src/api/axios.js, which
# routes every request through the backend's index.php directly (a
# literal file, always served regardless of rewrite support) instead of
# relying on any .htaccess to route a clean .../api/... URL to it.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
